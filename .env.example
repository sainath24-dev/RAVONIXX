# RAVONIXX Environment Configuration Template
# Copy this file to .env.local for local development

# Discord Webhook URL for match & player registration notifications (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Google / YouTube Data API v3 Key for esports video search (Optional)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE

# Admin Console Authentication
# Provide a strong password and secret salt in your local .env.local
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE
ADMIN_SECRET_KEY=YOUR_RANDOM_SECRET_KEY_HERE
